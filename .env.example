# Copy this file to .env and fill in your own values. Never commit .env itself.
ANTHROPIC_API_KEY=sk-ant-...

# Signs session cookies. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start without this set. Keep it secret -- anyone who
# has it can forge a valid login session for any account.
SESSION_SECRET_KEY=

# Set to "true" once this is running behind real HTTPS (any shared/remote
# deployment). Marks the session cookie Secure (HTTPS-only) and turns on
# HSTS. Leave unset/false for local http://127.0.0.1 development -- with
# it set, login won't work over plain HTTP at all.
SESSION_COOKIE_SECURE=false

# Used by scripts/reset_password.py and scripts/invite_user.py to build a
# full clickable link. Set this to wherever the app is actually reachable
# once it's not just http://127.0.0.1:8000 (e.g. https://commentinsight.example.com).
APP_BASE_URL=http://127.0.0.1:8000

# Needed for scripts/invite_user.py to actually email an invite (rather
# than just printing the link for you to send yourself). Sign up at
# resend.com, verify a sending domain there (it walks you through adding a
# couple of DNS records), and paste the API key it gives you below.
RESEND_API_KEY=

# The "from" address invite emails are sent from -- must be on the domain
# you verified with Resend above. Format: "Display Name <address@domain>".
INVITE_FROM_EMAIL=Comment Insight <invites@yourdomain.com>
